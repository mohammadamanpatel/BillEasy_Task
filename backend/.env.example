# PostgreSQL connection string from Neon Tech
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gemini model. Change to a model available on your account.
GEMINI_MODEL=gemini-3.6-flash

# AI mode: auto (use Gemini if a key is present, otherwise the built-in mock)
#          gemini (always use the real API)
#          mock   (always use the built-in mock, useful for offline testing)
AI_MODE=auto

# Port the backend listens on (keep the frontend proxy in vite.config.js in sync)
PORT=8000

# Frontend origin allowed to call this API
CORS_ORIGIN=http://localhost:5173

# Default business used when the frontend does not pass a business id
BUSINESS_NAME=Kiran's Grocery Store